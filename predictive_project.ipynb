import glob, warnings
import numpy as np, pandas as pd
import matplotlib.pyplot as plt, seaborn as sns
from sklearn.model_selection import train_test_split, cross_val_score, GridSearchCV
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import make_pipeline
from sklearn.linear_model import LinearRegression, LogisticRegression, Ridge
from sklearn.discriminant_analysis import LinearDiscriminantAnalysis as LDA, QuadraticDiscriminantAnalysis as QDA
from sklearn.tree import DecisionTreeClassifier
from sklearn.metrics import (mean_absolute_error, mean_squared_error, r2_score, accuracy_score, precision_score,
                             recall_score, f1_score, roc_auc_score, roc_curve, confusion_matrix, classification_report)
from statsmodels.tsa.holtwinters import ExponentialSmoothing
from statsmodels.tsa.arima.model import ARIMA
warnings.filterwarnings('ignore')

df = pd.read_csv(glob.glob('/kaggle/input/datasets/priyanshupatro1710/indianinflation/indiainflation-cpi-states.csv')[0], skiprows=1)   
print('Rows, columns:', df.shape)
display(df.head())
df.info()


print('Missing values:\n', df.isnull().sum())
print('States with missing inflation:', list(df[df.inflation_rate.isnull()].state.unique()))
print('Duplicate rows:', df.duplicated().sum())

df['date'] = pd.to_datetime(dict(year=df.year, month=df.month, day=1))
df = df.sort_values(['state', 'sector', 'date']).reset_index(drop=True)
full = df.copy()                                  
df = df.dropna(subset=['inflation_rate'])         
print('Rows after removing missing:', len(df))

# Outliers with the IQR rule
q1, q3 = df.inflation_rate.quantile([0.25, 0.75])
low, high = q1 - 1.5 * (q3 - q1), q3 + 1.5 * (q3 - q1)
out = df[(df.inflation_rate < low) | (df.inflation_rate > high)]
print(f'Normal range {low:.2f} to {high:.2f} -> {len(out)} outliers (kept, they are real values)')
display(out[['state', 'sector', 'date', 'inflation_rate']].sort_values('inflation_rate').head())


print(df.inflation_rate.agg(['mean', 'median', 'var', 'std']).round(2))
print('Mode:', df.inflation_rate.mode()[0])
display(df.groupby('sector').inflation_rate.agg(['mean', 'median', 'var', 'std']).round(2))

fig, ax = plt.subplots(2, 2, figsize=(13, 9))
sns.histplot(df.inflation_rate, kde=True, ax=ax[0, 0]);  ax[0, 0].set_title('Distribution of inflation')
sns.boxplot(x='sector', y='inflation_rate', data=df, ax=ax[0, 1]);  ax[0, 1].set_title('Box plot by sector')
df[df.sector == 'Combined'].groupby('state').inflation_rate.mean().nlargest(10).sort_values().plot.barh(ax=ax[1, 0])
ax[1, 0].set_title('Top 10 states by average inflation')
df.groupby(['date', 'sector']).inflation_rate.mean().unstack().plot(ax=ax[1, 1]);  ax[1, 1].set_title('Average inflation over time')
plt.tight_layout();  plt.show()


g = df.groupby(['state', 'sector'])
df['index_change'] = g.index_value.pct_change() * 100       
df['prev_inflation'] = g.inflation_rate.shift(1)             
df = df.dropna(subset=['index_change', 'prev_inflation'])
df = pd.concat([df, pd.get_dummies(df.sector, prefix='sector', drop_first=True, dtype=int)], axis=1)

df['high'] = (df.inflation_rate > 4).astype(int)                                       
df['level'] = pd.cut(df.inflation_rate, [-np.inf, 2, 4, np.inf], labels=[0, 1, 2]).astype(int)   
features = ['index_value', 'index_change', 'prev_inflation', 'month', 'sector_Rural', 'sector_Urban']
display(df[['state', 'sector', 'date'] + features + ['inflation_rate', 'high', 'level']].head())

sns.heatmap(df[features + ['inflation_rate']].corr(), annot=True, fmt='.2f', cmap='coolwarm')
plt.title('Correlation heatmap');  plt.show()

train, test = train_test_split(df, test_size=0.2, random_state=42, stratify=df.level)  
sc = StandardScaler().fit(train[features])
Xtr, Xte = sc.transform(train[features]), sc.transform(test[features])
print('Train rows:', len(train), '| Test rows:', len(test))


lin = LinearRegression().fit(Xtr, train.inflation_rate)
pred = lin.predict(Xte)
print('Weights:\n', pd.Series(lin.coef_, index=features).round(3))

res = test[['state', 'sector', 'date', 'inflation_rate']].rename(columns={'inflation_rate': 'actual'})
res['predicted'] = pred.round(2)
res['error'] = (res.actual - res.predicted).round(2)
display(res.head(10))

def reg_scores(y, p):
    return pd.Series({'MAE': mean_absolute_error(y, p), 'RMSE': np.sqrt(mean_squared_error(y, p)), 'R2': r2_score(y, p)}).round(3)
lin_scores = pd.DataFrame({'Train': reg_scores(train.inflation_rate, lin.predict(Xtr)), 'Test': reg_scores(test.inflation_rate, pred)}).T
display(lin_scores)

plt.scatter(test.inflation_rate, pred, alpha=0.5);  plt.plot([-6, 12], [-6, 12], 'r--')
plt.xlabel('Actual inflation');  plt.ylabel('Predicted inflation');  plt.title('Actual vs predicted');  plt.show()


models = {'Logistic Regression': LogisticRegression(max_iter=1000), 'LDA': LDA(), 'QDA': QDA()}
res = test[['state', 'sector', 'date']].copy()
res['actual'] = test.high
rows = []
for name, m in models.items():
    m.fit(Xtr, train.high)
    p = m.predict(Xte)
    prob = m.predict_proba(Xte)[:, 1]
    res[name] = p
    rows.append({'Model': name, 'Accuracy': accuracy_score(test.high, p), 'Precision': precision_score(test.high, p),
                 'Recall': recall_score(test.high, p), 'F1': f1_score(test.high, p), 'AUC': roc_auc_score(test.high, prob)})
    print(name, 'confusion matrix [[TN FP] [FN TP]]:\n', confusion_matrix(test.high, p))
    plt.plot(*roc_curve(test.high, prob)[:2], label=name)

res['prob_high'] = models['Logistic Regression'].predict_proba(Xte)[:, 1].round(3)
display(res.head(10))
clf_scores = pd.DataFrame(rows).set_index('Model').round(3)
display(clf_scores)
print('Logistic odds ratios:\n', pd.Series(np.exp(models['Logistic Regression'].coef_[0]), index=features).round(2))

plt.plot([0, 1], [0, 1], 'k--');  plt.xlabel('False positive rate');  plt.ylabel('True positive rate')
plt.title('ROC curves');  plt.legend();  plt.show()


names = ['Low', 'Medium', 'High']
multi = LogisticRegression(max_iter=1000).fit(Xtr, train.level)
pm = multi.predict(Xte)

res = test[['state', 'sector', 'date']].copy()
res['actual'] = test.level.map(dict(enumerate(names)))
res['predicted'] = pd.Series(pm, index=test.index).map(dict(enumerate(names)))
res[['P_low', 'P_medium', 'P_high']] = multi.predict_proba(Xte).round(3)
display(res.head(10))

print('Confusion matrix (rows = actual, columns = predicted):\n', confusion_matrix(test.level, pm))
print(classification_report(test.level, pm, target_names=names))
macro_f1 = f1_score(test.level, pm, average='macro')


c = full[full.sector == 'Combined'].groupby('state').filter(lambda d: d.inflation_rate.notna().all()) 
series = c.groupby('date').inflation_rate.mean().asfreq('MS')
train_ts, test_ts = series[:15], series[15:]          

cmp = pd.DataFrame({'actual': test_ts,
                    'Exp. Smoothing': ExponentialSmoothing(train_ts, trend='add').fit().forecast(5),
                    'ARIMA': ARIMA(train_ts, order=(1, 1, 1)).fit().forecast(5)})
display(cmp.round(2))
ts_scores = pd.DataFrame({n: {'MAE': mean_absolute_error(cmp.actual, cmp[n]),
                              'RMSE': np.sqrt(mean_squared_error(cmp.actual, cmp[n]))} for n in ['Exp. Smoothing', 'ARIMA']}).T.round(3)
display(ts_scores)

series.plot(marker='o', label='Actual', figsize=(10, 4))
series.rolling(3).mean().plot(label='3-month moving average')
cmp[['Exp. Smoothing', 'ARIMA']].plot(ax=plt.gca(), style='--', marker='x')
plt.title('Average inflation of all states: actual and forecast');  plt.ylabel('Inflation (%)');  plt.legend();  plt.show()


mk = lambda m: make_pipeline(StandardScaler(), m)       
cv = {'Linear (RMSE)': -cross_val_score(mk(LinearRegression()), train[features], train.inflation_rate, cv=5,
                                        scoring='neg_root_mean_squared_error')}
for name, m in models.items():
    cv[name + ' (F1)'] = cross_val_score(mk(m), train[features], train.high, cv=5, scoring='f1')
cv = pd.DataFrame(cv).T
cv.columns = ['fold1', 'fold2', 'fold3', 'fold4', 'fold5']
cv['mean'] = cv.mean(axis=1)
display(cv.round(3))


g1 = GridSearchCV(mk(LogisticRegression(max_iter=1000)), {'logisticregression__C': [0.01, 0.1, 1, 10, 100]},
                  cv=5, scoring='f1').fit(train[features], train.high)
g2 = GridSearchCV(mk(Ridge()), {'ridge__alpha': [0.01, 0.1, 1, 10, 100]},
                  cv=5, scoring='neg_root_mean_squared_error').fit(train[features], train.inflation_rate)
display(pd.DataFrame(g1.cv_results_)[['param_logisticregression__C', 'mean_test_score']].round(3))
print('Logistic best C:', g1.best_params_, '| CV F1:', round(g1.best_score_, 3),
      '| Test F1:', round(f1_score(test.high, g1.predict(test[features])), 3))
print('Ridge best alpha:', g2.best_params_, '| CV RMSE:', round(-g2.best_score_, 3),
      '| Test RMSE:', round(np.sqrt(mean_squared_error(test.inflation_rate, g2.predict(test[features]))), 3))


rows = []
for d in range(1, 16):
    t = DecisionTreeClassifier(max_depth=d, random_state=42).fit(train[features], train.high)
    rows.append({'depth': d,
                 'train_F1': f1_score(train.high, t.predict(train[features])),
                 'cv_F1': cross_val_score(DecisionTreeClassifier(max_depth=d, random_state=42), train[features], train.high, cv=5, scoring='f1').mean(),
                 'test_F1': f1_score(test.high, t.predict(test[features]))})
depth = pd.DataFrame(rows).set_index('depth').round(3)
display(depth)

depth[['train_F1', 'cv_F1']].plot(marker='o', figsize=(9, 4))
plt.title('Train vs validation F1: gap on the right = overfitting');  plt.ylabel('F1 score');  plt.show()
print('Best depth by cross-validation:', depth.cv_F1.idxmax())


print('LINEAR REGRESSION'); display(lin_scores)
print('CLASSIFICATION (high inflation)'); display(clf_scores)
print('MULTINOMIAL LOGISTIC -> Accuracy:', round(accuracy_score(test.level, pm), 3), '| Macro F1:', round(macro_f1, 3))
print('TIME SERIES (last 5 months)'); display(ts_scores)
